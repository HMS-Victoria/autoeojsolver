# EOJ 自动刷题系统 · 环境变量模板
# 用法：复制本文件为 .env 后填写真实值（.env 不会进版本库）
# Designed by HMS_Victorious
#
# 优先级：命令行参数 > 环境变量 / .env > eoj_config.json > 内置默认值

# ============================================================
# EOJ 账号（必需）
# ============================================================
EOJ_USERNAME=your@stu.ecnu.edu.cn
EOJ_PASSWORD=your_password
# EOJ_BASE_URL=https://acm.ecnu.edu.cn

# ============================================================
# 大模型接口（必需其一）
# ============================================================
# 通用变量优先级最高，适用于任何 OpenAI 兼容服务
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# 官方在用的模型 ID（可运行 `python eoj_auto_solver.py --list-models` 实时查询）
LLM_MODEL=deepseek-v4-pro
# 主模型失败时依次降级的备选模型（逗号分隔）
# LLM_FALLBACK_MODELS=deepseek-flash

# 也可以按供应商分别设置
# DEEPSEEK_API_KEY=sk-...
# SILICONFLOW_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# ============================================================
# 模型调用参数（可选）
# ============================================================
LLM_TIMEOUT=180           # 单次请求超时（秒）
LLM_MAX_RETRIES=3         # 失败重试次数（401/403 不重试）
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192       # 推理模型会先消耗思考 token，不建议调太小

# ============================================================
# 运行行为（可选）
# ============================================================
# EOJ_SOLUTIONS_DIR=D:\path\to\eoj_solutions
# EOJ_PER_PROBLEM_TIMEOUT=150   # 单题总时长上限（秒），0=不限时
# EOJ_MAX_RETRIES=3             # 编译/测试失败后 AI 重写次数
# EOJ_SUBMIT_INTERVAL=1.0       # 批量提交间隔（秒）
# EOJ_JUDGE_WAIT=30             # 等待判题的最长秒数
# EOJ_GPP=C:\mingw64\bin\g++.exe  # 手动指定 g++ 路径
# EOJ_PROXY=http://127.0.0.1:7890 # 访问 EOJ 的代理（模型 API 不走代理）
